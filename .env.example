# OmniManager configuration.
# Copy to `.env` (repository root) or `backend/.env` and fill in values. Real environment variables
# always win over these files. Never commit a filled-in .env.

# --- Core -------------------------------------------------------------------------------
# Development only. With DJANGO_DEBUG=false a real DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=true
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests (the React app's origin).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection (required). The role needs CREATEDB to run the test suites.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/omnimanager
# DATABASE_CONN_MAX_AGE=60

# Public URL of the React app: used in emails and payment return URLs.
FRONTEND_URL=http://localhost:5173

# --- Cookies / HTTPS (defaults are secure when DJANGO_DEBUG=false) ------------------------
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=0
# SESSION_COOKIE_AGE=1209600

# --- Files ------------------------------------------------------------------------------
# Uploaded files are stored privately and served only through permission-checked endpoints.
# Relative paths are resolved from the repository root.
# MEDIA_ROOT=backend/var/media
# MAX_UPLOAD_SIZE_MB=15
# Storage backend class; default is the private local filesystem. A remote backend (e.g. S3 via
# django-storages) also needs its package installed and its settings added to backend/config/settings.py.
# FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# --- Email ------------------------------------------------------------------------------
# Default writes each email to backend/var/mail/ so nothing is sent during development.
# EMAIL_FILE_PATH=backend/var/mail
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=OmniManager <no-reply@example.com>

# --- Online payments --------------------------------------------------------------------
# "sandbox" (local simulator, default) or "stripe".
PAYMENT_PROVIDER=sandbox
# Signing secret for the sandbox simulator's webhooks. Any long random string.
SANDBOX_WEBHOOK_SECRET=
# Stripe (only when PAYMENT_PROVIDER=stripe). Use test keys (sk_test_...) until you go live.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Rate limits (DRF throttles) --------------------------------------------------------
# THROTTLE_AUTH=20/min
# THROTTLE_PASSWORD_RESET=5/min
# THROTTLE_PAYMENTS=30/min
# THROTTLE_WEBHOOKS=300/min

# --- Demo data --------------------------------------------------------------------------
# Password given to the seeded demo accounts (seed_demo refuses to run with DJANGO_DEBUG=false).
# DEMO_PASSWORD=

# LOG_LEVEL=INFO

# --- Frontend (read by Vite from frontend/.env or the shell, not from this file) ----------
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_PORT=5173

# --- End-to-end tests -------------------------------------------------------------------
# Defaults to DATABASE_URL with an "_e2e" suffix; the suite drops and reseeds its data.
# E2E_DATABASE_URL=
# Set these in your shell when running `make e2e` (Playwright does not read .env files):
#   E2E_API_PORT=8001  E2E_WEB_PORT=5174
#   PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chromium  (instead of `npx playwright install chromium`)
